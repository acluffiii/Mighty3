# Sunovabit — Apache settings for Bluehost (or any cPanel/Apache host).
# Upload this file into public_html along with the rest of the site.

# Serve index.html for folders, so /dentdog/ loads dentdog/index.html
DirectoryIndex index.html
Options -Indexes

# Custom "Well, that's a sunovabit." page for missing URLs
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Send www.sunovabit.com to sunovabit.com, always over https
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Send http:// to https:// (turn on the free SSL in Bluehost first)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compress text files so pages load faster
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Let browsers cache images and styles; always re-check HTML pages
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

# Small security hardening
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never serve the developer notes or build script
<FilesMatch "^(README\.md|CNAME\.example|build-zip\.sh)$">
  Require all denied
</FilesMatch>
